# ─── Build Artifacts ──────────────────────────────────────
/build/
/bin/
*.obj
*.pdb
*.ilk
*.exp
*.iobj
*.ipdb

# ─── Compiled Shaders (sources in shaders/src/) ───────────
# NOTE: the .spv files in assets/shaders/ ARE committed (prebuilt for distribution)
# Only ignore intermediary .spv outputs from the build process
shaders/*.spv.bak

# ─── Binaries / DLLs (deployed by build.bat, not versioned) ──
*.dll
*.exe
*.lib
*.pdb
*.msix
*.msixbundle
*.msixupload
*.appx
*.appxbundle

# Exception for vendored WebView2 loader
!third_party/webview2/build/native/x64/WebView2Loader.dll
!third_party/webview2/build/native/x64/WebView2Loader.dll.lib

# WebView2 package metadata and unused managed assemblies
third_party/webview2/lib/
third_party/webview2/lib_manual/
third_party/webview2/tools/
third_party/webview2/package/
third_party/webview2/\[Content_Types\].xml
third_party/webview2/_rels/
third_party/webview2/*.nuspec
third_party/webview2/*.p7s
third_party/webview2/buildTransitive/

# ─── Protobuf generated files ─────────────────────────────
/build/proto_gen/

# ─── MSIX packaging staging ───────────────────────────────
packaging/staging/

# ─── User / IDE Files ─────────────────────────────────────
.vs/
*.user
*.suo
*.sdf
*.VC.db
.vscode/settings.json

# ─── Sensitive data (NEVER commit credentials) ────────────
accounts.json
consoles.json
avatar.png
*.npsso
*.token
portalpc.log
ludelo.log
*.log
AUDIT.md
backup*/
PUBLISH-REPORT.md
[FAIL]
[OK]
docs/notes/
scratch/

# ─── OS Files ─────────────────────────────────────────────
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# ─── Test binaries ────────────────────────────────────────
/bin/tests/

# ─── Temporary files ──────────────────────────────────────
*.tmp
*.bak
~$*
